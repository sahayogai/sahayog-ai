# Sarvam AI — STT + TTS
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Azure OpenAI — LLM
# Get from: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Server
HOST=0.0.0.0
PORT=8765

# Allowed CORS origins (comma-separated, no trailing slash)
# Since nginx proxies /api/, the browser never calls the backend directly,
# so this mainly protects against direct access. Include your live domain.
CORS_ORIGINS=https://www.sahayogai.in,https://sahayogai.in
