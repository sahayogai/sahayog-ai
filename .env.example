# ─────────────────────────────────────────────────────────────────────────────
# SahyogAI — environment variables
# Copy this file to `.env` (git-ignored) ONLY if you need to override defaults.
# Vite only exposes vars prefixed with VITE_ to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID.
# The production ID is already committed as a default in src/analytics/ga.js, so
# production builds track automatically — you do NOT need to set this to deploy.
# Set it here only to OVERRIDE the default, e.g. to point local/staging at a
# separate GA property. NOTE: setting it also turns analytics ON in `npm run dev`
# (by default dev is analytics-free so localhost traffic never pollutes prod).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to route events to GA4 DebugView and log every event to the
# browser console (prefix "[GA4]"). Handy while validating; leave off for prod.
# VITE_GA_DEBUG=false
